<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="android:windowLightNavigationBar">@bool/light_navigation_bar</item>
    </style>

    <style name="Theme.LauncherActivity" parent="AppTheme">
        <item name="android:windowBackground">@color/splashBackgroundColor</item>
        <item name="android:statusBarColor">@color/statusBarColor</item>
        <item name="android:navigationBarColor">@color/navigationBarColor</item>
    </style>
</resources>
